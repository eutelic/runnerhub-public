[Unit]
Description=RunnerHub host agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/runnerhub/agent.env
ExecStart=/usr/local/bin/runnerhub-agent
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/runnerhub /run /tmp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
