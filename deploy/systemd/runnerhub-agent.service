[Unit]
Description=RunnerHub Agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/runnerhub/agent.env
ExecStart=/usr/local/bin/runnerhub-agent
Restart=always
RestartSec=3
StateDirectory=runnerhub
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/runnerhub

[Install]
WantedBy=multi-user.target
