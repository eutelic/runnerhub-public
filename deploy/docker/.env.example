# Copy this file to deploy/docker/.env and replace every placeholder.
# Generate independent secrets with: openssl rand -hex 32

RUNNERHUB_ENROLLMENT_TOKEN=replace-with-random-enrollment-token
RUNNERHUB_AGENT_SECRET=replace-with-random-agent-secret-at-least-32-bytes
RUNNERHUB_API_KEYS=replace-with-random-admin-key:admin:local-admin

# GitHub App client ID (recommended JWT issuer) and host path to its PEM key.
RUNNERHUB_GITHUB_APP_ISSUER=Iv1.replace-with-client-id
RUNNERHUB_GITHUB_APP_PRIVATE_KEY_FILE=/absolute/path/to/runnerhub-github-app.pem

# Optional overrides.
# RUNNERHUB_GITHUB_API_URL=https://api.github.com
# RUNNERHUB_HOST_NAME=my-runner-host
# RUNNERHUB_ALLOWED_IMAGES=ghcr.io/actions/actions-runner:latest
# RUNNERHUB_RUNNER_IMAGE=ghcr.io/actions/actions-runner:latest
