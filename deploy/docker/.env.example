# Copy this file to deploy/docker/.env and replace the GitHub placeholders.
# Generate independent secrets with: openssl rand -hex 32

RUNNERHUB_ENROLLMENT_TOKEN=replace-with-random-enrollment-token
RUNNERHUB_AGENT_SECRET=replace-with-random-agent-secret-at-least-32-bytes
RUNNERHUB_ADMIN_KEY=replace-with-random-admin-key
RUNNERHUB_SCALESET_KEY=replace-with-random-scaler-key
RUNNERHUB_API_KEYS=replace-with-random-admin-key:admin:local-admin,replace-with-random-scaler-key:scaler:scaleset-listener

# GitHub App numeric ID, Client ID, App slug, installation ID, and host path to the app PEM
# key. The numeric App ID is used for JWT authentication while the Client ID
# is used by GitHub OAuth and the scale-set client.
# For the default repository-scoped autoscaling path, RUNNERHUB_GITHUB_URL must
# be https://github.com/OWNER/REPOSITORY (or the equivalent URL on GHES).
RUNNERHUB_GITHUB_APP_ID=123456789
RUNNERHUB_GITHUB_APP_CLIENT_ID=Iv1.replace-with-client-id
RUNNERHUB_GITHUB_APP_SLUG=replace-with-app-slug
RUNNERHUB_GITHUB_APP_INSTALLATION_ID=12345678
RUNNERHUB_GITHUB_APP_PRIVATE_KEY_FILE=/absolute/path/to/runnerhub-github-app.pem
RUNNERHUB_GITHUB_URL=https://github.com/OWNER/REPOSITORY

# Default automatic repository-scoped pool/scale-set settings.
RUNNERHUB_POOL_ID=pool-docker
RUNNERHUB_SCALESET_NAME=runnerhub
RUNNERHUB_MIN_RUNNERS=0
RUNNERHUB_MAX_RUNNERS=2

# Safe default: workflow containers do not get Docker capability.
RUNNERHUB_POOL_ISOLATION=container-trusted
RUNNERHUB_ALLOW_PRIVILEGED_WORKERS=false

# Ephemeral runners refresh the configured image before each start by default.
# Use "missing" or "never" only when image updates are managed separately.
RUNNERHUB_DOCKER_PULL_POLICY=always
RUNNERHUB_DIND_IMAGE=docker:29.1.3-dind@sha256:173f284a4299164772a90f52b373e73e087583c0963f1334c9995f190ef6f3f5

# To support Docker container actions, service containers, or `container:` jobs,
# set BOTH of these explicitly. container-dind starts a privileged, per-worker
# Docker daemon but still does not mount the host Docker socket into the job.
# RUNNERHUB_POOL_ISOLATION=container-dind
# RUNNERHUB_ALLOW_PRIVILEGED_WORKERS=true

# Optional overrides.
# RUNNERHUB_GITHUB_API_URL=https://api.github.com
# RUNNERHUB_HOST_NAME=my-runner-host
# RUNNERHUB_ALLOWED_IMAGES=ghcr.io/actions/actions-runner:2.337.0@sha256:e5496277be5d09bc968b3d64911b74e219ac4a3f2edce956a3ecf9271bea1ef4
# RUNNERHUB_RUNNER_IMAGE=ghcr.io/actions/actions-runner:2.337.0@sha256:e5496277be5d09bc968b3d64911b74e219ac4a3f2edce956a3ecf9271bea1ef4
# RUNNERHUB_RUNNER_GROUP=
# RUNNERHUB_RUNNER_GROUP_ID=1
